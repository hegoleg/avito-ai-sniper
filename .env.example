# ========================================================
# НАСТРОЙКИ AVITO AI SNIPER (ОПЕРАТИВНАЯ ПАМЯТЬ)
# ========================================================

# 1. Telegram (для получения уведомлений на телефон)
# Создать бота в https://t.me/BotFather -> скопировать токен
TELEGRAM_BOT_TOKEN=

# Узнать свой Chat ID в https://t.me/userinfobot -> скопировать цифры
TELEGRAM_CHAT_ID=

# 2. Искусственный интеллект (Бесплатно)
# Получить бесплатный ключ на https://aistudio.google.com/
# Если оставить пустым — включится встроенный умный эвристический анализ!
GEMINI_API_KEY=

# 3. Параметры поиска
# Локация: rossiya (вся РФ), moskva, ufa, spb, etc.
SEARCH_LOCATION=rossiya
SEARCH_QUERY=оперативная память
MIN_PRICE=500
MAX_PRICE=25000

# 4. Настройки работы бота
# Интервал проверки новых объявлений в минутах (рекомендуется 3-5)
POLL_INTERVAL_MINUTES=4

# Режим браузера: true (фоновый/тихий) или false (с окном)
HEADLESS=true

# (Опционально) Прокси, если запускаете на удаленном сервере без GUI
# Формат: http://user:password@ip:port
PROXY_URL=
